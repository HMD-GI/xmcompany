<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xm.mapper.PurchaseOrderMapper">

    <!-- 采购订单VO的结果映射 -->
    <resultMap id="PurchaseOrderVOMap" type="com.xm.vo.PurchaseOrderVO">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="supplier_id" property="supplierId"/>
        <result column="supplier_name" property="supplierName"/>
        <result column="supplier_code" property="supplierCode"/>
        <result column="item_name" property="itemName"/>
        <result column="unit_price" property="unitPrice"/>
        <result column="quantity" property="quantity"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="status" property="status"/>
        <result column="status_name" property="statusName"/>
        <result column="purchase_request_id" property="purchaseRequestId"/>
        <result column="applicant" property="applicant"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 查询采购订单详情SQL片段 -->
    <sql id="purchaseOrderDetailSql">
        SELECT
            po.*,
            s.name AS supplier_name,
            s.code AS supplier_code,
            pr.applicant,
            CASE po.status
                WHEN 0 THEN '待确认'
                WHEN 1 THEN '已确认'
                WHEN 2 THEN '已下单'
                WHEN 3 THEN '已到货'
                WHEN 4 THEN '已完成'
                WHEN 5 THEN '已作废'
                ELSE '未知状态'
            END AS status_name
        FROM
            purchase_order po
        LEFT JOIN supplier s ON po.supplier_id = s.id
        LEFT JOIN purchase_request pr ON po.purchase_request_id = pr.id
    </sql>

    <!-- 分页查询采购订单列表 -->
    <select id="selectPurchaseOrderPage" resultMap="PurchaseOrderVOMap">
        <include refid="purchaseOrderDetailSql"/>
        <where>
            <!-- 动态拼接查询条件 -->
            <if test="query.orderNo != null and query.orderNo != ''">
                AND po.order_no LIKE CONCAT('%', #{query.orderNo}, '%')
            </if>
            <if test="query.supplierId != null">
                AND po.supplier_id = #{query.supplierId}
            </if>
            <if test="query.itemName != null and query.itemName != ''">
                AND po.item_name LIKE CONCAT('%', #{query.itemName}, '%')
            </if>
            <if test="query.status != null">
                AND po.status = #{query.status}
            </if>
            <if test="query.purchaseRequestId != null">
                AND po.purchase_request_id = #{query.purchaseRequestId}
            </if>
        </where>
        ORDER BY po.create_time DESC
    </select>
    
    <!-- 根据ID查询采购订单详情 -->
    <select id="getPurchaseOrderById" resultMap="PurchaseOrderVOMap">
        <include refid="purchaseOrderDetailSql"/>
        WHERE po.id = #{id}
    </select>
</mapper> 